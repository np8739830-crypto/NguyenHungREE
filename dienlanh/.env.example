# ============================================
# ĐIỆN LẠNH NGUYÊN HÙNG - Environment Config
# ============================================
# Copy this file to .env for local development. Never commit the real .env.
PORT=5000
HOST=0.0.0.0
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-value
# Persistent session directory used in production.
SESSION_DB_DIR=./data

# SQL Server Configuration
DB_SERVER=localhost
# Leave blank to use the local default SQL Server instance.
DB_PORT=
# Use "trusted" for Windows integrated authentication or "sql" on a Linux VPS.
DB_AUTH_MODE=trusted
# Required only when DB_AUTH_MODE=sql. Never commit real credentials.
DB_USER=
DB_PASSWORD=
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server
DB_NAME=DienLanhNguyenHung
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Telegram notifications (keep actual values only in .env)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Email Configuration (for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=Điện Lạnh Nguyên Hùng <info@dienlanhnguyenhung.vn>

# Site URL
SITE_URL=http://localhost:5000
ADMIN_URL=http://localhost:5000/admin

PAYROLL_DELETE_PASSWORD=change-this-payroll-delete-password

# Used only by `npm run db:seed` to create the first administrator.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-one-time-password
ADMIN_PHONE=0000000000
