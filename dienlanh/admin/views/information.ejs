<!doctype html>
<html lang="vi">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/admin/css/1.css?v=20260811-2">
    <style>
        .info-tabs {
            display: flex;
            gap: 0;
            border-bottom: 2px solid #e8eaed;
            margin-bottom: 24px;
            flex-wrap: wrap;
            background: #f8f9fa;
            border-radius: 8px 8px 0 0;
            overflow: hidden;
        }
        
        .info-tab {
            padding: 13px 24px;
            font-size: 0.88rem;
            font-weight: 500;
            color: #6c757d;
            cursor: pointer;
            border-bottom: 2px solid transparent;
            margin-bottom: -2px;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 8px;
            background: transparent;
            border: none;
            font-family: 'Roboto', sans-serif;
        }
        
        .info-tab:hover {
            color: #1e3a5f;
            background: rgba(30, 58, 95, 0.04);
        }
        
        .info-tab.active {
            color: #1e3a5f;
            border-bottom-color: #1e3a5f;
            background: #fff;
        }
        
        .info-panel {
            display: none;
        }
        
        .info-panel.active-panel {
            display: block;
        }
        
        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px 24px;
        }
        
        .form-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }
        
        .form-group label {
            font-size: 0.85rem;
            font-weight: 500;
            color: #495057;
        }
        
        .form-input,
        .form-select {
            padding: 9px 12px;
            border: 1px solid #ced4da;
            border-radius: 5px;
            font-size: 0.88rem;
            font-family: 'Roboto', sans-serif;
            color: #495057;
            background: #fff;
            width: 100%;
        }
        
        .form-input:focus,
        .form-select:focus {
            border-color: #2a5298;
            outline: none;
            box-shadow: 0 0 0 3px rgba(42, 82, 152, .12);
        }
        
        .section-title {
            font-size: 1rem;
            font-weight: 600;
            color: #1e3a5f;
            margin-bottom: 18px;
            padding-bottom: 10px;
            border-bottom: 1px solid #e8eaed;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .form-actions {
            display: flex;
            gap: 12px;
            justify-content: flex-end;
            margin-top: 24px;
            padding-top: 18px;
            border-top: 1px solid #e8eaed;
        }
        
        .btn-save {
            padding: 10px 28px;
            background: linear-gradient(135deg, #1e3a5f, #2a5298);
            color: #fff;
            border: none;
            border-radius: 5px;
            font-size: 0.88rem;
            font-weight: 500;
            cursor: pointer;
            font-family: 'Roboto', sans-serif;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        
        .btn-cancel {
            padding: 10px 28px;
            background: #f8f9fa;
            color: #495057;
            border: 1px solid #ced4da;
            border-radius: 5px;
            font-size: 0.88rem;
            font-weight: 500;
            cursor: pointer;
            font-family: 'Roboto', sans-serif;
        }
        
        @media (max-width: 768px) {
            .form-grid {
                grid-template-columns: 1fr;
            }
            .info-tabs {
                overflow-x: auto;
                flex-wrap: nowrap;
            }
            .info-tab {
                white-space: nowrap;
                padding: 12px 16px;
            }
        }
    </style>
</head>

<body>
    <div class="wrapper service-dashboard">
        <%- include('partials/admin-header', { activePage: 'information' }) %>
            <main class="content-wrapper">
                <section class="content-header dashboard-heading">
                    <div>
                        <p class="dashboard-eyebrow">Cấu hình website</p>
                        <h1><i class="fa-solid fa-circle-info"></i> Cấu hình thông tin</h1>
                    </div>
                </section>
                <% if (success_msg?.length) { %>
                    <div class="notice success">
                        <%= success_msg[0] %>
                    </div>
                    <% } %>
                        <% if (error_msg?.length) { %>
                            <div class="notice error">
                                <%= error_msg[0] %>
                            </div>
                            <% } %>

                                <div class="card">
                                    <div class="card-body" style="padding-bottom:0;">
                                        <div class="info-tabs">
                                            <button class="info-tab active" data-panel="chung"><i class="fa-solid fa-sliders"></i> Thông tin chung</button>
                                            <button class="info-tab" data-panel="seo"><i class="fa-solid fa-magnifying-glass"></i> SEO</button>
                                            <button class="info-tab" data-panel="mxh"><i class="fa-solid fa-share-nodes"></i> Mạng xã hội</button>
                                            <button class="info-tab" data-panel="config"><i class="fa-solid fa-gear"></i> Cấu hình</button>
                                        </div>
                                    </div>
                                </div>

                                <div id="panel-chung" class="info-panel active-panel">
                                    <div class="card">
                                        <div class="card-header">
                                            <h3><i class="fa-solid fa-building"></i> Thông tin liên hệ</h3>
                                        </div>
                                        <div class="card-body">
                                            <div class="form-grid">
                                                <div class="form-group"><label>Tên doanh nghiệp</label><input type="text" class="form-input" value="<%= info.company_name || 'CÔNG TY TNHH TM & DV NGUYỄN HÙNG' %>"></div>
                                                <div class="form-group"><label>Điện thoại</label><input type="text" class="form-input" value="<%= info.phone || '028 2242 2822' %>"></div>
                                                <div class="form-group"><label>Email</label><input type="email" class="form-input" value="<%= info.email || 'info@nguyenhung.vn' %>"></div>
                                                <div class="form-group"><label>Địa chỉ</label><input type="text" class="form-input" value="<%= info.address || '2 Hoàng Ngân, Quận 8, TP.HCM' %>"></div>
                                            </div>
                                            <div class="form-actions"><button class="btn-cancel">Hủy</button><button class="btn-save"><i class="fa-solid fa-floppy-disk"></i> Lưu thông tin</button></div>
                                        </div>
                                    </div>
                                </div>

                                <div id="panel-seo" class="info-panel">
                                    <div class="card">
                                        <div class="card-header">
                                            <h3><i class="fa-solid fa-magnifying-glass"></i> Cấu hình SEO</h3>
                                        </div>
                                        <div class="card-body">
                                            <div class="form-grid">
                                                <div class="form-group"><label>Meta Title</label><input type="text" class="form-input" value="<%= info.site_name || 'Điện Lạnh Nguyễn Hùng' %> - Sửa chữa, bảo trì, lắp đặt điện lạnh"></div>
                                                <div class="form-group"><label>Meta Description</label><input type="text" class="form-input" value="<%= info.site_description || 'Dịch vụ sửa chữa, bảo trì và lắp đặt thiết bị điện lạnh chuyên nghiệp' %>"></div>
                                            </div>
                                            <div class="form-actions"><button class="btn-cancel">Hủy</button><button class="btn-save"><i class="fa-solid fa-floppy-disk"></i> Lưu SEO</button></div>
                                        </div>
                                    </div>
                                </div>

                                <div id="panel-mxh" class="info-panel">
                                    <div class="card">
                                        <div class="card-header">
                                            <h3><i class="fa-solid fa-share-nodes"></i> Liên kết mạng xã hội</h3>
                                        </div>
                                        <div class="card-body">
                                            <div class="form-grid">
                                                <div class="form-group"><label><i class="fa-brands fa-facebook" style="color:#1877f2;"></i> Facebook URL</label><input type="text" class="form-input" value="<%= info.facebook_url || 'https://facebook.com/dienlanhnguyenhung' %>"></div>
                                                <div class="form-group"><label><i class="fa-brands fa-youtube" style="color:#ff0000;"></i> YouTube URL</label><input type="text" class="form-input" value="<%= info.youtube_url || 'https://youtube.com/@dienlanhnguyenhung' %>"></div>
                                                <div class="form-group"><label><i class="fa-brands fa-zalo" style="color:#0068ff;"></i> Zalo</label><input type="text" class="form-input" value="<%= info.zalo_phone || '028 2242 2822' %>"></div>
                                            </div>
                                            <div class="form-actions"><button class="btn-cancel">Hủy</button><button class="btn-save"><i class="fa-solid fa-floppy-disk"></i> Lưu mạng xã hội</button></div>
                                        </div>
                                    </div>
                                </div>

                                <div id="panel-config" class="info-panel">
                                    <div class="card">
                                        <div class="card-header">
                                            <h3><i class="fa-solid fa-gear"></i> Cấu hình hệ thống</h3>
                                        </div>
                                        <div class="card-body">
                                            <div class="form-grid">
                                                <div class="form-group"><label>Giờ làm việc</label><input type="text" class="form-input" value="<%= info.working_hours || '7:45 - 17:30 (T2 - CN)' %>"></div>
                                                <div class="form-group"><label>Kinh nghiệm</label><input type="text" class="form-input" value="<%= info.about_experience || '14+ Năm kinh nghiệm' %>"></div>
                                                <div class="form-group"><label>Số khách hàng</label><input type="text" class="form-input" value="<%= info.about_customers || '5000+' %>"></div>
                                            </div>
                                            <div class="form-actions"><button class="btn-cancel">Hủy</button><button class="btn-save"><i class="fa-solid fa-floppy-disk"></i> Lưu cấu hình</button></div>
                                        </div>
                                    </div>
                                </div>
            </main>
            <footer class="main-footer">
                <div class="float-left">© 2026 <strong>NGUYỄN HÙNG</strong> — Quản trị dịch vụ điện lạnh.</div>
                <div class="float-right">Dashboard dịch vụ</div>
            </footer>
    </div>
    <script src="/admin/js/1.js?v=20260811-2"></script>
    <script>
        document.querySelectorAll('.info-tab').forEach(function(tab) {
            tab.addEventListener('click', function() {
                document.querySelectorAll('.info-tab').forEach(function(t) {
                    t.classList.remove('active');
                });
                this.classList.add('active');
                document.querySelectorAll('.info-panel').forEach(function(p) {
                    p.classList.remove('active-panel');
                });
                var panelId = 'panel-' + this.getAttribute('data-panel');
                var panel = document.getElementById(panelId);
                if (panel) panel.classList.add('active-panel');
            });
        });
    </script>
</body>

</html>
