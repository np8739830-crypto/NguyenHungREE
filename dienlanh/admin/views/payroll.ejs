<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"><link rel="stylesheet" href="/admin/css/1.css?v=20260827-policy"><style>
.pay-head{display:flex;justify-content:space-between;align-items:end;gap:15px}.pay-head p{color:#687e93;margin-top:6px}.pay-actions,.row-actions{display:flex;gap:7px;flex-wrap:wrap}.pbtn{border:0;border-radius:8px;padding:10px 13px;font-weight:700;cursor:pointer;background:#eaf1f7;color:#294b6b}.pbtn.primary{background:#2463a7;color:#fff}.pbtn.green{background:#168252;color:#fff}.pbtn.red{background:#b43d3d;color:#fff}.filters{display:grid;grid-template-columns:110px 120px minmax(180px,1fr) 160px 170px auto;gap:10px;padding:16px}.filters input,.filters select,.modal-form input,.modal-form select,.modal-form textarea{width:100%;padding:10px;border:1px solid #ccd7e1;border-radius:8px;font:inherit}.stats{display:grid;grid-template-columns:repeat(5,1fr);gap:13px;margin:17px 0}.stat{background:#fff;border-radius:11px;padding:15px;border-left:4px solid #2b68a5;box-shadow:0 3px 12px #163c5d12}.stat span{color:#6b7e91;font-size:12px}.stat strong{display:block;margin-top:6px;color:#193b5b;font-size:18px}.table-scroll{overflow:auto}.ptable{min-width:1580px;width:100%;border-collapse:collapse}.ptable th,.ptable td{padding:10px 8px;border-bottom:1px solid #e4ebf1;text-align:left;white-space:nowrap}.ptable th{background:#eef4f8;color:#3c566e;font-size:12px}.money{font-variant-numeric:tabular-nums}.net{font-weight:800;color:#126444}.badge{padding:5px 8px;border-radius:999px;font-size:11px;font-weight:800;background:#fff0d9;color:#9a5a15}.badge.paid{background:#dcf5e7;color:#126d43}.badge.warning{background:#ffe4e4;color:#a52929}.badge.locked{background:#e7e8ec;color:#424a56}.ibtn{width:33px;height:33px;border:0;border-radius:7px;color:#fff;cursor:pointer;background:#2473ad}.ibtn.money{background:#168252}.ibtn.warn{background:#ba7a18}.ibtn.red{background:#b43d3d}.modal[hidden]{display:none}.modal{position:fixed;inset:0;z-index:1300;display:grid;place-items:center;padding:15px}.shade{position:absolute;inset:0;background:#06192e99}.dialog{position:relative;background:#fff;border-radius:14px;width:min(850px,100%);max-height:calc(100vh - 30px);overflow:auto;box-shadow:0 20px 60px #07192faa}.modal-head{display:flex;justify-content:space-between;padding:19px 21px;border-bottom:1px solid #e4ebf1}.modal-body{padding:20px}.modal-foot{display:flex;justify-content:flex-end;gap:9px;padding:0 20px 20px}.modal-form{display:grid;grid-template-columns:1fr 1fr;gap:13px}.modal-form label{display:block;font-weight:700;color:#38526b;margin-bottom:6px}.full{grid-column:1/-1}.detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px 25px}.detail-row{display:flex;justify-content:space-between;border-bottom:1px dashed #d7e0e8;padding:8px 0;gap:15px}.history{margin-top:18px;background:#f5f8fa;border-radius:9px;padding:13px}.toastbox{position:fixed;right:18px;top:70px;z-index:1500}.toast{padding:12px 16px;color:#fff;background:#16774d;border-radius:9px;margin-bottom:8px}.toast.err{background:#ac3434}.empty{text-align:center!important;padding:40px!important;color:#71869a}.pagination{display:flex;justify-content:space-between;padding:14px}.skeleton{height:14px;background:#e5edf3;border-radius:5px}@media(max-width:1000px){.filters{grid-template-columns:repeat(2,1fr)}.stats{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){.pay-head{align-items:flex-start;flex-direction:column}.filters,.stats,.modal-form,.detail-grid{grid-template-columns:1fr}.full{grid-column:auto}}@media print{body *{visibility:hidden}#detailBody,#detailBody *{visibility:visible}#detailBody{position:absolute;inset:0;padding:25px}}
.pay-head{flex-wrap:wrap}.pay-head>div:first-child{min-width:0}.pay-actions{flex:0 0 auto;margin-left:auto}.content-wrapper,.content-wrapper>section,.content-wrapper .card{min-width:0;max-width:100%}.filters input,.filters select{min-width:0}.stats{grid-template-columns:repeat(auto-fit,minmax(180px,1fr))}.stat{min-width:0}.table-scroll{display:block;width:100%;max-width:100%;overflow-x:auto}@media(max-width:1250px){.filters{grid-template-columns:repeat(3,minmax(0,1fr))}.pay-actions{width:100%;margin-left:0}}@media(max-width:700px){.filters{grid-template-columns:1fr}.pay-actions .pbtn{flex:1}}
</style></head><body><div class="wrapper service-dashboard"><%- include('partials/admin-header',{activePage:'payroll'}) %><main class="content-wrapper"><section class="content-header pay-head"><div><p class="dashboard-eyebrow">Nhân sự & tài chính</p><h1><i class="fa-solid fa-money-check-dollar"></i> Quản lý bảng lương</h1><p>Doanh thu → năng suất → lương → tạm ứng → thanh toán → lịch sử.</p></div><div class="pay-actions"><button class="pbtn" id="export"><i class="fa-solid fa-file-excel"></i> Xuất Excel</button><button class="pbtn primary" id="generate" <%= can('payroll','create') ? '' : 'hidden' %>><i class="fa-solid fa-plus"></i> Tạo bảng lương tháng</button></div></section>
<section class="card"><div class="filters"><select id="month"></select><select id="year"></select><input id="search" placeholder="Tên hoặc mã nhân viên"><select id="grade"><option value="">Tất cả loại NV</option><option value="assistant">Phụ điện lạnh</option><option value="technician">Bậc thợ điện lạnh</option></select><select id="status"><option value="">Tất cả trạng thái</option><option value="created">Đã tạo</option><option value="advanced">Đã tạm ứng</option><option value="pending_payment">Chờ thanh toán</option><option value="paid">Đã thanh toán</option><option value="warning">Có cảnh báo</option><option value="locked">Đã khóa</option></select><button class="pbtn" id="reset">Đặt lại</button></div></section>
<section class="stats"><div class="stat"><span>Tổng nhân viên</span><strong id="sEmployees">—</strong></div><div class="stat"><span>Tổng quỹ lương</span><strong id="sFund">—</strong></div><div class="stat"><span>Đã tạm ứng</span><strong id="sAdvance">—</strong></div><div class="stat"><span>Đã thanh toán</span><strong id="sPaid">—</strong></div><div class="stat"><span>Còn phải trả</span><strong id="sBalance">—</strong></div></section>
<div style="display:flex;justify-content:flex-end;margin:-4px 0 14px"><button class="pbtn red" id="deleteCreatedPayroll" <%= can('payroll','delete') ? '' : 'hidden' %>><i class="fa-solid fa-trash"></i> Xóa bảng lương vừa tạo</button></div>
<section class="card"><div class="card-header"><h3><i class="fa-solid fa-table-list"></i> Bảng lương theo chính sách</h3></div><div class="table-scroll"><table class="ptable"><thead><tr><th>STT</th><th>Mã NV</th><th>Nhân viên</th><th>Loại NV</th><th>Doanh thu</th><th>Mức năng suất</th><th>Lương CB</th><th>Phụ cấp</th><th>Thưởng</th><th>Phạt/KT</th><th>Tạm ứng</th><th>Thực nhận</th><th>Còn trả</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody id="rows"></tbody></table></div><div class="pagination"><span id="pageInfo"></span><div><button class="pbtn" id="prev">Trước</button> <button class="pbtn" id="next">Sau</button></div></div></section></main></div>
<div class="modal" id="generateModal" hidden><div class="shade" data-close></div><div class="dialog" style="width:min(500px,100%)"><div class="modal-head"><h2>Xác nhận tạo bảng lương tháng</h2><button class="pbtn" data-close>✕</button></div><form id="generateForm"><div class="modal-body modal-form"><div><label>Tháng</label><select name="payroll_month" required></select></div><div><label>Năm</label><input name="payroll_year" type="number" min="2000" max="2100" required></div><div class="full"><p style="color:#60778d">Bạn có muốn tạo bảng lương cho tất cả kỹ thuật viên đủ điều kiện trong kỳ đã chọn? Hệ thống dùng doanh thu booking đã hoàn tất và đã thanh toán; bảng lương đã tồn tại được giữ nguyên.</p></div></div><div class="modal-foot"><button type="button" class="pbtn" data-close>Hủy</button><button class="pbtn primary">Xác nhận tạo</button></div></form></div></div>
<div class="modal" id="actionModal" hidden><div class="shade" data-close></div><div class="dialog" style="width:min(520px,100%)"><div class="modal-head"><h2 id="actionTitle"></h2><button class="pbtn" data-close>✕</button></div><form id="actionForm"><div class="modal-body modal-form"><input type="hidden" name="payroll_id"><input type="hidden" name="action"><div><label>Số tiền</label><input name="amount" type="number" min="0" step="1000" required></div><div class="dateField"><label>Ngày thực hiện</label><input name="date" type="date"></div><div class="methodField"><label>Phương thức</label><select name="payment_method"><option value="cash">Tiền mặt</option><option value="bank_transfer">Chuyển khoản</option></select></div><div class="reasonField full"><label>Lý do</label><input name="reason"></div><div class="full"><label>Ghi chú</label><textarea name="note" rows="3"></textarea></div></div><div class="modal-foot"><button type="button" class="pbtn" data-close>Hủy</button><button class="pbtn green">Lưu giao dịch</button></div></form></div></div>
<div class="modal" id="detailModal" hidden><div class="shade" data-close></div><div class="dialog"><div class="modal-head"><h2>Chi tiết & lịch sử bảng lương</h2><button class="pbtn" data-close>✕</button></div><div class="modal-body" id="detailBody"></div><div class="modal-foot"><button class="pbtn" onclick="window.print()"><i class="fa-solid fa-print"></i> In / PDF</button><button class="pbtn" data-close>Đóng</button></div></div></div><div class="toastbox" id="toasts"></div><script src="/admin/js/1.js"></script><script>
(()=>{const csrf=<%- JSON.stringify(csrfToken) %>,canUpdate=<%= can('payroll','update')?'true':'false' %>,canDelete=<%= can('payroll','delete')?'true':'false' %>;const $=s=>document.querySelector(s),money=v=>new Intl.NumberFormat('vi-VN',{style:'currency',currency:'VND',maximumFractionDigits:0}).format(Number(v)||0),esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));let page=1,pages=1,timer;const now=new Date();$('#month').innerHTML='<option value="">Tất cả tháng</option>'+Array.from({length:12},(_,i)=>`<option value="${i+1}">Tháng ${i+1}</option>`).join('');$('#year').innerHTML='<option value="">Tất cả năm</option>'+Array.from({length:8},(_,i)=>`<option>${now.getFullYear()-i}</option>`).join('');$('#month').value=now.getMonth()+1;$('#year').value=now.getFullYear();$('#generateForm').payroll_month.innerHTML=Array.from({length:12},(_,i)=>`<option value="${i+1}">Tháng ${i+1}</option>`).join('');
function toast(m,e=false){const x=document.createElement('div');x.className='toast'+(e?' err':'');x.textContent=m;$('#toasts').append(x);setTimeout(()=>x.remove(),3500)}function open(id){$(id).hidden=false;document.body.style.overflow='hidden'}function close(){document.querySelectorAll('.modal').forEach(x=>x.hidden=true);document.body.style.overflow=''}document.querySelectorAll('[data-close]').forEach(x=>x.onclick=close);async function api(url,opt={}){const r=await fetch(url,{credentials:'same-origin',headers:{Accept:'application/json','Content-Type':'application/json','X-CSRF-Token':csrf},...opt}),d=await r.json().catch(()=>({message:'Phản hồi không hợp lệ'}));if(!r.ok)throw Error(d.message||d.error);return d}function params(){return new URLSearchParams({month:$('#month').value,year:$('#year').value,search:$('#search').value,job_grade:$('#grade').value,status:$('#status').value,page,limit:10})}const labels={created:'Đã tạo',advanced:'Đã tạm ứng',pending_payment:'Chờ thanh toán',paid:'Đã thanh toán',warning:'Có cảnh báo',locked:'Đã khóa',unpaid:'Chưa thanh toán'};
async function load(){$('#rows').innerHTML=Array.from({length:4},()=>'<tr>'+Array.from({length:15},()=>'<td><div class="skeleton"></div></td>').join('')+'</tr>').join('');try{const d=await api('/admin/api/payroll?'+params());pages=d.pagination.totalPages;$('#sEmployees').textContent=d.stats.employee_total;$('#sFund').textContent=money(d.stats.total_fund);$('#sAdvance').textContent=money(d.stats.advance_total);$('#sPaid').textContent=money(d.stats.paid_total);$('#sBalance').textContent=money(d.stats.balance_total);$('#rows').innerHTML=d.data.length?d.data.map((x,i)=>`<tr><td>${(d.pagination.page-1)*d.pagination.limit+i+1}</td><td>${esc(x.employee_code)}</td><td><strong>${esc(x.employee_name)}</strong></td><td>${x.job_grade==='technician'?'Bậc thợ':'Phụ điện lạnh'}<br><small>${x.employee_type==='probation'?'Thử việc':'Chính thức'}</small></td><td class="money">${money(x.revenue_amount)}</td><td class="money">${money(x.productivity_salary)}<br><small>${esc(x.productivity_band||'')}</small></td><td class="money">${money(x.base_salary)}</td><td class="money">${money(x.allowance)}</td><td class="money">${money(x.bonus)}</td><td class="money">${money(x.deduction)}</td><td class="money">${money(x.advance_total)}</td><td class="money net">${money(x.net_salary)}</td><td class="money net">${money(x.balance_due)}</td><td><span class="badge ${x.status}">${labels[x.status]||x.status}</span></td><td><div class="row-actions"><button class="ibtn" data-a="view" data-id="${x.id}" title="Xem"><i class="fa-solid fa-eye"></i></button>${canUpdate&&!x.is_locked?`<button class="ibtn money" data-a="advance" data-id="${x.id}" title="Tạm ứng"><i class="fa-solid fa-hand-holding-dollar"></i></button><button class="ibtn money" data-a="payment" data-id="${x.id}" title="Thanh toán"><i class="fa-solid fa-money-bill-transfer"></i></button><button class="ibtn warn" data-a="deduction" data-id="${x.id}" title="Phạt"><i class="fa-solid fa-minus"></i></button><button class="ibtn" data-a="bonus" data-id="${x.id}" title="Thưởng"><i class="fa-solid fa-plus"></i></button><button class="ibtn warn" data-a="lock" data-id="${x.id}" title="Khóa"><i class="fa-solid fa-lock"></i></button>`:''}${canDelete&&!x.is_locked?`<button class="ibtn red" data-a="delete" data-id="${x.id}" title="Xóa"><i class="fa-solid fa-trash"></i></button>`:''}</div></td></tr>`).join(''):'<tr><td colspan="15" class="empty">Chưa có bảng lương trong kỳ này.</td></tr>';$('#pageInfo').textContent=`Trang ${d.pagination.page}/${d.pagination.totalPages} · ${d.pagination.total} bản ghi`;$('#prev').disabled=page<=1;$('#next').disabled=page>=pages}catch(e){$('#rows').innerHTML=`<tr><td colspan="15" class="empty">${esc(e.message)}</td></tr>`;toast(e.message,true)}}
async function detail(id){try{const x=(await api('/admin/api/payroll/'+id)).payroll,rows=(title,items)=>`<div class="history"><strong>${title}</strong>${items.length?items.map(i=>`<p>${esc(i.reason||i.action_key||i.note||'Giao dịch')} — ${money(i.amount||0)} — ${new Date(i.created_at).toLocaleString('vi-VN')}</p>`).join(''):'<p>Chưa có dữ liệu.</p>'}</div>`;$('#detailBody').innerHTML=`<h2 style="text-align:center">PHIẾU LƯƠNG ${x.payroll_month}/${x.payroll_year}</h2>${x.warning_message?`<div class="notice error">${esc(x.warning_message)}</div>`:''}<div class="detail-grid"><div class="detail-row"><span>Nhân viên</span><strong>${esc(x.employee_name)}</strong></div><div class="detail-row"><span>Mã NV</span><strong>${esc(x.employee_code)}</strong></div><div class="detail-row"><span>Loại NV</span><strong>${x.job_grade==='technician'?'Bậc thợ':'Phụ điện lạnh'} / ${x.employee_type==='probation'?'Thử việc':'Chính thức'}</strong></div><div class="detail-row"><span>Kỳ lương</span><strong>${new Date(x.period_start).toLocaleDateString('vi-VN')} – ${new Date(x.period_end).toLocaleDateString('vi-VN')}</strong></div><div class="detail-row"><span>Doanh thu thực tế</span><strong>${money(x.revenue_amount)}</strong></div><div class="detail-row"><span>Mức năng suất</span><strong>${money(x.productivity_salary)}</strong></div><div class="detail-row"><span>Lương cơ bản</span><strong>${money(x.base_salary)}</strong></div><div class="detail-row"><span>Phụ cấp ăn/xăng/điện thoại</span><strong>${money(x.meal_allowance)} / ${money(x.fuel_allowance)} / ${money(x.phone_allowance)}</strong></div><div class="detail-row"><span>Ngày công / nghỉ / không phép</span><strong>${x.working_days}/${x.standard_days} · ${x.leave_days} · ${x.unauthorized_leave_days}</strong></div><div class="detail-row"><span>Trừ nghỉ không phép</span><strong>${money(x.unauthorized_leave_deduction)}</strong></div><div class="detail-row"><span>Tổng lương</span><strong>${money(x.net_salary)}</strong></div><div class="detail-row"><span>Tạm ứng</span><strong>${money(x.advance_total)}</strong></div><div class="detail-row"><span>Đã thanh toán</span><strong>${money(x.paid_total)}</strong></div><div class="detail-row"><span>Còn phải trả</span><strong>${money(x.balance_due)}</strong></div></div>${rows('Tạm ứng',x.advances)}${rows('Thanh toán',x.payments)}${rows('Kỷ luật / khấu trừ',x.deductions)}${rows('Thưởng',x.bonuses)}${rows('Lịch sử thay đổi',x.audit)}`;open('#detailModal')}catch(e){toast(e.message,true)}}
async function action(id,a){const title={advance:'Tạo tạm ứng (tối đa 50%)',payment:'Thanh toán lương ngày 15',deduction:'Thêm phạt / khấu trừ',bonus:'Thêm thưởng'}[a];$('#actionTitle').textContent=title;const f=$('#actionForm');f.reset();f.payroll_id.value=id;f.action.value=a;if(['advance','payment'].includes(a)){try{const p=(await api('/admin/api/payroll/'+id)).payroll;f.date.value=a==='advance'?`${p.payroll_year}-${String(p.payroll_month).padStart(2,'0')}-01`:`${p.payroll_month===12?p.payroll_year+1:p.payroll_year}-${String(p.payroll_month===12?1:p.payroll_month+1).padStart(2,'0')}-15`}catch(e){toast(e.message,true);return}}document.querySelector('.dateField').style.display=['advance','payment'].includes(a)?'block':'none';document.querySelector('.methodField').style.display=a==='payment'?'block':'none';document.querySelector('.reasonField').style.display=['deduction','bonus'].includes(a)?'block':'none';open('#actionModal')}
$('#rows').onclick=async e=>{const b=e.target.closest('[data-a]');if(!b)return;const {a,id}=b.dataset;if(a==='view')return detail(id);if(['advance','payment','deduction','bonus'].includes(a))return action(id,a);if(a==='delete'&&confirm('Xóa bảng lương chưa có giao dịch?'))try{const d=await api('/admin/api/payroll/'+id,{method:'DELETE'});toast(d.message);load()}catch(x){toast(x.message,true)}if(a==='lock'&&confirm('Khóa bảng lương? Sau khi khóa không thể sửa hoặc giao dịch.'))try{const d=await api('/admin/api/payroll/'+id+'/lock',{method:'POST',body:'{}'});toast(d.message);load()}catch(x){toast(x.message,true)}};
$('#actionForm').onsubmit=async e=>{e.preventDefault();const f=e.currentTarget,d=Object.fromEntries(new FormData(f)),id=d.payroll_id,a=d.action;delete d.payroll_id;delete d.action;try{const r=await api(`/admin/api/payroll/${id}/${a}`,{method:'POST',body:JSON.stringify(d)});close();toast(r.message);load()}catch(x){toast(x.message,true)}};$('#generate').onclick=()=>{$('#generateForm').payroll_month.value=$('#month').value||now.getMonth()+1;$('#generateForm').payroll_year.value=$('#year').value||now.getFullYear();open('#generateModal')};$('#generateForm').onsubmit=async e=>{e.preventDefault();try{const r=await api('/admin/api/payroll/generate',{method:'POST',body:JSON.stringify(Object.fromEntries(new FormData(e.currentTarget)))});close();toast(r.message);load()}catch(x){toast(x.message,true)}};$('#export').onclick=()=>{const p=params();p.delete('page');p.delete('limit');location.href='/admin/api/payroll/export?'+p};[$('#month'),$('#year'),$('#grade'),$('#status')].forEach(x=>x.onchange=()=>{page=1;load()});$('#search').oninput=()=>{clearTimeout(timer);timer=setTimeout(()=>{page=1;load()},350)};$('#reset').onclick=()=>{$('#month').value='';$('#year').value='';$('#grade').value='';$('#status').value='';$('#search').value='';page=1;load()};$('#prev').onclick=()=>{if(page>1){page--;load()}};$('#next').onclick=()=>{if(page<pages){page++;load()}};
async function appendRevenue(id){try{const d=await api(`/admin/api/payroll/${id}/revenue`),x=d.payroll,items=d.automatic.details,source=d.selected.source==='manual'?'Doanh thu nhập thủ công':'Tự động từ đơn dịch vụ';const section=document.createElement('section');section.className='revenue-box';section.innerHTML=`<h3>DOANH THU & NĂNG SUẤT</h3><div class="detail-grid"><div class="detail-row"><span>Doanh thu trong tháng</span><strong>${money(d.selected.amount)}</strong></div><div class="detail-row"><span>Nguồn doanh thu</span><strong>${source}</strong></div><div class="detail-row"><span>Mức năng suất</span><strong>${Number(x.revenue_amount)===0?'Không áp dụng':money(x.productivity_salary)}</strong></div><div class="detail-row"><span>Chấm công</span><strong>${x.warning_message?.includes('Chưa có dữ liệu chấm công')?'Chưa có dữ liệu chấm công':`${x.working_days} ngày công · ${x.leave_days} nghỉ phép · ${x.unauthorized_leave_days} nghỉ không phép · ${x.overtime_hours} giờ tăng ca`}</strong></div></div><div class="revenue-actions">${canUpdate&&!x.is_locked?'<button class="pbtn primary" data-revenue-sync>Đồng bộ doanh thu</button><button class="pbtn" data-revenue-manual>Nhập doanh thu thủ công</button>':''}</div><h3>CHI TIẾT DOANH THU</h3><div class="table-scroll"><table class="revenue-table"><thead><tr><th>Ngày</th><th>Mã đơn/HĐ</th><th>Khách hàng</th><th>Nội dung</th><th>Doanh thu</th><th>Trạng thái</th></tr></thead><tbody>${items.length?items.map(i=>`<tr><td>${new Date(i.revenue_date).toLocaleDateString('vi-VN')}</td><td>${esc(i.request_code||i.id)}</td><td>${esc(i.customer_name)}</td><td>${esc(i.content)}</td><td>${money(i.revenue_amount)}</td><td>Hoàn thành / Đã thanh toán</td></tr>`).join(''):'<tr><td colspan="6" class="empty">Không có đơn hợp lệ trong kỳ.</td></tr>'}</tbody></table></div><p class="revenue-total"><strong>Tổng doanh thu hệ thống: ${money(d.automatic.total)}</strong></p>${d.manual?`<p class="revenue-note">Điều chỉnh thủ công: ${money(d.manual.revenue_amount)} · ${esc(d.manual.note||'Không có ghi chú')}</p>`:''}`;$('#detailBody').append(section);section.querySelector('[data-revenue-sync]')?.addEventListener('click',async()=>{try{const r=await api(`/admin/api/payroll/${id}/revenue/sync`,{method:'POST',body:'{}'});toast(r.message);await detail(id);await appendRevenue(id);load()}catch(e){toast(e.message,true)}});section.querySelector('[data-revenue-manual]')?.addEventListener('click',async()=>{const value=prompt('Nhập doanh thu thủ công (VNĐ):',String(d.manual?.revenue_amount??d.selected.amount));if(value===null)return;const note=prompt('Ghi chú lý do điều chỉnh: ',d.manual?.note||'');try{const r=await api(`/admin/api/payroll/${id}/revenue/manual`,{method:'POST',body:JSON.stringify({revenue_amount:value,note})});toast(r.message);await detail(id);await appendRevenue(id);load()}catch(e){toast(e.message,true)}})}catch(e){toast(e.message,true)}}
$('#rows').addEventListener('click',e=>{const button=e.target.closest('[data-a="view"]');if(button)setTimeout(()=>appendRevenue(button.dataset.id),0)});load()})();
</script><script>
document.getElementById('deleteCreatedPayroll')?.addEventListener('click',async function(){
    const notify=(message,error=false)=>{const item=document.createElement('div');item.className='toast'+(error?' err':'');item.textContent=message;document.getElementById('toasts').append(item);setTimeout(()=>item.remove(),3500)};
    const send=async(url,options={})=>{const response=await fetch(url,{credentials:'same-origin',headers:{Accept:'application/json','Content-Type':'application/json','X-CSRF-Token':<%- JSON.stringify(csrfToken) %>},...options});const data=await response.json().catch(()=>({message:'Phản hồi máy chủ không hợp lệ.'}));if(!response.ok)throw new Error(data.message||data.error||'Không thể xóa bảng lương.');return data};
    const query=new URLSearchParams({month:document.getElementById('month').value,year:document.getElementById('year').value,page:1,limit:10});
    try{
        const list=await send('/admin/api/payroll?'+query);
        if(list.data.length!==1){notify('Hãy lọc đúng tháng/năm có một bảng lương cần xóa.',true);return}
        const payroll=list.data[0];
        if(!confirm(`Xóa bảng lương ${payroll.employee_name} kỳ ${payroll.payroll_month}/${payroll.payroll_year}?`))return;
        if(payroll.is_locked)await send('/admin/api/payroll/'+payroll.id+'/unlock',{method:'POST',body:'{}'});
        const result=await send('/admin/api/payroll/'+payroll.id,{method:'DELETE'});
        notify(result.message);setTimeout(()=>location.reload(),500);
    }catch(error){notify(error.message,true)}
});
</script><script>
(()=>{
 const canDelete=<%= can('payroll','delete')?'true':'false' %>,csrf=<%- JSON.stringify(csrfToken) %>;if(!canDelete)return;
 const money=value=>new Intl.NumberFormat('vi-VN',{style:'currency',currency:'VND',maximumFractionDigits:0}).format(Number(value)||0),escape=value=>String(value??'').replace(/[&<>"']/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
 const modal=document.createElement('div');modal.className='modal';modal.id='deletePayrollModal';modal.hidden=true;modal.innerHTML='<div class="shade" data-delete-close></div><div class="dialog" style="width:min(560px,100%)"><div class="modal-head"><h2><i class="fa-solid fa-triangle-exclamation"></i> Xóa bảng lương</h2><button class="pbtn" data-delete-close>✕</button></div><div class="modal-body" id="deletePayrollBody"></div><div class="modal-foot"><button class="pbtn" data-delete-close>Hủy</button><button class="pbtn red" id="confirmPayrollDelete">Xóa bảng lương</button></div></div>';document.body.append(modal);const passwordModal=document.createElement('div');passwordModal.className='modal';passwordModal.id='deletePasswordModal';passwordModal.hidden=true;passwordModal.innerHTML='<div class="shade" data-password-close></div><div class="dialog" style="width:min(480px,100%)"><div class="modal-head"><h2><i class="fa-solid fa-key"></i> Xác nhận mật khẩu</h2><button class="pbtn" data-password-close>✕</button></div><form id="deletePasswordForm" novalidate><div class="modal-body"><p>Vui lòng nhập mật khẩu để xác nhận xóa bảng lương.</p><label for="payrollDeletePassword" style="display:block;font-weight:700;margin:14px 0 6px">Mật khẩu</label><div style="display:flex;gap:7px"><input id="payrollDeletePassword" name="deletePassword" type="password" autocomplete="current-password" style="flex:1;padding:10px;border:1px solid #ccd7e1;border-radius:8px"><button type="button" class="pbtn" id="toggleDeletePassword" aria-label="Hiện hoặc ẩn mật khẩu"><i class="fa-solid fa-eye"></i></button></div><p id="deletePasswordError" style="min-height:20px;margin:6px 0 0;color:#b02f2f;font-weight:700"></p></div><div class="modal-foot"><button type="button" class="pbtn" data-password-close>Hủy</button><button class="pbtn red">Xác nhận xóa</button></div></form></div>';document.body.append(passwordModal);
 let selected=null,phase=1;
 function close(){modal.hidden=true;passwordModal.hidden=true;selected=null;phase=1;document.getElementById('deletePasswordForm').reset();document.getElementById('deletePasswordError').textContent='';document.body.style.overflow=''}modal.querySelectorAll('[data-delete-close]').forEach(button=>button.onclick=close);passwordModal.querySelectorAll('[data-password-close]').forEach(button=>button.onclick=close);
 async function request(url,options={}){const response=await fetch(url,{credentials:'same-origin',headers:{Accept:'application/json','Content-Type':'application/json','X-CSRF-Token':csrf},...options}),data=await response.json().catch(()=>({message:'Phản hồi máy chủ không hợp lệ.'}));if(!response.ok)throw Error(data.message||'Không thể xóa bảng lương.');return data}
 function notify(message,error=false){const item=document.createElement('div');item.className='toast'+(error?' err':'');item.textContent=message;document.getElementById('toasts').append(item);setTimeout(()=>item.remove(),3500)}
 async function openDelete(id){try{selected=(await request('/admin/api/payroll/'+id)).payroll;phase=1;render();modal.hidden=false;document.body.style.overflow='hidden'}catch(error){notify(error.message,true)}}
 function render(){const body=document.getElementById('deletePayrollBody');body.innerHTML=`<h3>Bạn có chắc muốn xóa bảng lương này?</h3><div class="detail-grid"><div class="detail-row"><span>Nhân viên</span><strong>${escape(selected.employee_name)}</strong></div><div class="detail-row"><span>Mã nhân viên</span><strong>${escape(selected.employee_code)}</strong></div><div class="detail-row"><span>Tháng/năm</span><strong>${selected.payroll_month}/${selected.payroll_year}</strong></div><div class="detail-row"><span>Lương thực nhận</span><strong>${money(selected.net_salary)}</strong></div><div class="detail-row"><span>Trạng thái</span><strong>${escape(selected.status)}</strong></div></div><div class="notice error" style="margin-top:16px">Thao tác này sẽ xóa bảng lương và các dữ liệu thanh toán liên quan. Không thể hoàn tác.</div>`}
 document.getElementById('confirmPayrollDelete').onclick=()=>{if(!selected)return;modal.hidden=true;passwordModal.hidden=false;document.getElementById('payrollDeletePassword').focus()};document.getElementById('toggleDeletePassword').onclick=()=>{const input=document.getElementById('payrollDeletePassword'),icon=document.querySelector('#toggleDeletePassword i');input.type=input.type==='password'?'text':'password';icon.className=input.type==='password'?'fa-solid fa-eye':'fa-solid fa-eye-slash'};document.getElementById('deletePasswordForm').onsubmit=async event=>{event.preventDefault();const input=document.getElementById('payrollDeletePassword'),error=document.getElementById('deletePasswordError'),password=input.value;if(!password){error.textContent='Vui lòng nhập mật khẩu.';input.focus();return}error.textContent='';try{const result=await request('/admin/api/payroll/'+selected.id,{method:'DELETE',body:JSON.stringify({deletePassword:password})});input.value='';close();notify(result.message);document.getElementById('month').dispatchEvent(new Event('change'))}catch(exception){input.value='';error.textContent=exception.message;input.focus()}};
 document.addEventListener('click',event=>{const rowButton=event.target.closest('[data-a="delete"],[data-admin-delete]'),recent=event.target.closest('#deleteCreatedPayroll');if(!rowButton&&!recent)return;event.preventDefault();event.stopImmediatePropagation();if(rowButton)return openDelete(rowButton.dataset.id||rowButton.dataset.adminDelete);const query=new URLSearchParams({month:document.getElementById('month').value,year:document.getElementById('year').value,page:1,limit:10});request('/admin/api/payroll?'+query).then(list=>{if(list.data.length!==1)throw Error('Hãy lọc đúng tháng/năm có một bảng lương cần xóa.');return openDelete(list.data[0].id)}).catch(error=>notify(error.message,true))},true);
 const observer=new MutationObserver(()=>document.querySelectorAll('#rows tr').forEach(row=>{const actions=row.querySelector('.row-actions'),view=actions?.querySelector('[data-a="view"]');if(actions&&view&&!actions.querySelector('[data-a="delete"],[data-admin-delete]')){const button=document.createElement('button');button.className='ibtn red';button.dataset.adminDelete=view.dataset.id;button.title='Xóa';button.innerHTML='<i class="fa-solid fa-trash"></i>';actions.append(button)}}));observer.observe(document.getElementById('rows'),{childList:true,subtree:true});
})();
</script></body></html>
