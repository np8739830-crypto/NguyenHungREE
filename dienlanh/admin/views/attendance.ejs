<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"><link rel="stylesheet" href="/admin/css/1.css"><style>.ahead{display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap}.acts,.filters{display:flex;gap:9px;flex-wrap:wrap}.abtn{border:0;border-radius:8px;padding:10px 13px;font-weight:700;cursor:pointer;background:#eaf1f7;color:#294b6b}.abtn.primary{background:#2866a8;color:#fff}.filters{padding:16px}.filters>*{padding:10px;border:1px solid #ccd7e1;border-radius:8px;min-width:130px}.filters input{flex:1;min-width:220px}.astats{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:13px;margin:16px 0}.astat{background:#fff;border-left:4px solid #3974af;padding:15px;border-radius:10px}.astat strong{display:block;font-size:20px;margin-top:6px}.calendar{overflow:auto;max-width:100%}.atable{border-collapse:separate;border-spacing:0;min-width:max-content;width:100%}.atable th,.atable td{padding:8px;border-right:1px solid #e3eaf0;border-bottom:1px solid #e3eaf0;text-align:center}.atable th{background:#edf3f7}.sticky1{position:sticky;left:0;z-index:3;background:#fff!important;min-width:88px}.sticky2{position:sticky;left:88px;z-index:3;background:#fff!important;min-width:180px;text-align:left!important}.day{width:38px;height:34px;border:0;border-radius:6px;cursor:pointer;font-weight:800;background:#f2f5f7}.present{background:#def2e7;color:#176a44}.leave{background:#fff0cf;color:#8a5b0a}.unauthorized_leave{background:#fae1e1;color:#a12c2c}.holiday,.off{background:#e9ecf0;color:#59636e}.business_trip{background:#e0ebf8;color:#285f97}.modal[hidden]{display:none}.modal{position:fixed;inset:0;z-index:1300;display:grid;place-items:center;padding:15px}.shade{position:absolute;inset:0;background:#06192e99}.dialog{position:relative;background:#fff;border-radius:14px;width:min(600px,100%);padding:22px}.form{display:grid;grid-template-columns:1fr 1fr;gap:13px}.form label{display:block;font-weight:700;margin-bottom:5px}.form input,.form select,.form textarea{width:100%;padding:10px;border:1px solid #ccd7e1;border-radius:8px}.full{grid-column:1/-1}.foot{display:flex;justify-content:flex-end;gap:9px;margin-top:18px}.toast{position:fixed;right:18px;top:70px;padding:13px 17px;background:#16784d;color:#fff;border-radius:9px;z-index:1500}.toast.err{background:#ae3838}@media(max-width:650px){.form{grid-template-columns:1fr}.full{grid-column:auto}}</style></head><body><div class="wrapper service-dashboard"><%- include('partials/admin-header',{activePage:'attendance'}) %><main class="content-wrapper"><section class="content-header ahead"><div><p class="dashboard-eyebrow">Nhân sự</p><h1><i class="fa-solid fa-clipboard-check"></i> Chấm công</h1></div><div class="acts"><button class="abtn" id="excel">Xuất Excel</button><button class="abtn" id="bulk">Chấm công hàng loạt</button><button class="abtn primary" id="closeMonth">Chốt công tháng</button></div></section><section class="card"><div class="filters"><select id="month"></select><select id="year"></select><input id="search" placeholder="Tìm tên hoặc mã nhân viên"><select id="grade"><option value="">Tất cả bậc</option><option value="assistant">Phụ điện lạnh</option><option value="technician">Bậc thợ</option></select><button class="abtn" id="reset">Đặt lại</button></div></section><section class="astats"><div class="astat">Tổng nhân viên<strong id="se">0</strong></div><div class="astat">Tổng ngày công<strong id="sd">0</strong></div><div class="astat">Đi làm hôm nay<strong id="st">0</strong></div><div class="astat">Nghỉ phép<strong id="sl">0</strong></div><div class="astat">Nghỉ không phép<strong id="su">0</strong></div></section><section class="card"><div class="card-header"><h3 id="periodTitle">Bảng công</h3></div><div class="calendar"><table class="atable"><thead id="head"></thead><tbody id="body"></tbody></table></div></section></main></div>
<div class="modal" id="editModal" hidden><div class="shade" data-close></div><div class="dialog"><h2 id="editTitle">Chấm công</h2><form id="editForm" class="form"><input type="hidden" name="technician_id"><input type="hidden" name="attendance_date"><div class="full"><label>Nhân viên</label><strong id="employee"></strong></div><div><label>Trạng thái</label><select name="status"><option value="present">Đi làm</option><option value="leave">Nghỉ phép</option><option value="unauthorized_leave">Nghỉ không phép</option><option value="holiday">Nghỉ lễ</option><option value="business_trip">Công tác</option><option value="off">Nghỉ theo lịch</option></select></div><div><label>Tăng ca đã duyệt (giờ)</label><input name="overtime_hours" type="number" min="0" step="0.5" value="0"></div><div><label>Giờ vào</label><input name="check_in" type="time"></div><div><label>Giờ ra</label><input name="check_out" type="time"></div><div class="full"><label>Ghi chú / lý do sửa</label><textarea name="note" rows="3"></textarea></div><div class="foot full"><button type="button" class="abtn" data-close>Hủy</button><button class="abtn primary">Lưu chấm công</button></div></form></div></div>
<div class="modal" id="bulkModal" hidden><div class="shade" data-close></div><div class="dialog"><h2>Chấm công hàng loạt</h2><form id="bulkForm" class="form"><div><label>Ngày</label><input name="attendance_date" type="date" required></div><div><label>Trạng thái</label><select name="status"><option value="present">Đi làm</option><option value="leave">Nghỉ phép</option><option value="unauthorized_leave">Nghỉ không phép</option><option value="holiday">Nghỉ lễ</option><option value="off">Nghỉ</option></select></div><div class="full"><label>Chọn nhân viên</label><div id="checks"></div></div><div class="full"><label>Ghi chú</label><textarea name="note"></textarea></div><div class="foot full"><button type="button" class="abtn" data-close>Hủy</button><button class="abtn primary">Lưu hàng loạt</button></div></form></div></div><script src="/admin/js/1.js"></script><script>
(()=>{const csrf=<%- JSON.stringify(csrfToken) %>,$=s=>document.querySelector(s),state={data:[],closed:false},codes={present:'✓',leave:'P',unauthorized_leave:'KP',holiday:'L',business_trip:'CT',off:'OFF'},now=new Date();$('#month').innerHTML=Array.from({length:12},(_,i)=>`<option value="${i+1}">Tháng ${i+1}</option>`).join('');$('#year').innerHTML=Array.from({length:8},(_,i)=>`<option>${now.getFullYear()-i}</option>`).join('');$('#month').value=now.getMonth()+1;async function api(url,opt={}){const r=await fetch(url,{credentials:'same-origin',headers:{Accept:'application/json','Content-Type':'application/json','X-CSRF-Token':csrf},...opt}),d=await r.json();if(!r.ok)throw Error(d.message||'Có lỗi');return d}function toast(m,e=false){const x=document.createElement('div');x.className='toast'+(e?' err':'');x.textContent=m;document.body.append(x);setTimeout(()=>x.remove(),3000)}function open(id){$(id).hidden=false}function close(){document.querySelectorAll('.modal').forEach(x=>x.hidden=true)}document.querySelectorAll('[data-close]').forEach(x=>x.onclick=close);async function load(){try{const p=new URLSearchParams({month:$('#month').value,year:$('#year').value,search:$('#search').value,job_grade:$('#grade').value}),d=await api('/admin/api/attendance?'+p);state.data=d.data;state.closed=d.isClosed;$('#se').textContent=d.stats.employees;$('#sd').textContent=d.stats.total_days;$('#st').textContent=d.stats.present_today;$('#sl').textContent=d.stats.leave;$('#su').textContent=d.stats.unauthorized;$('#periodTitle').textContent=`Bảng công tháng ${$('#month').value}/${$('#year').value} · ${d.isClosed?'Đã chốt':'Chưa chốt'}`;$('#closeMonth').textContent=d.isClosed?'Mở khóa tháng':'Chốt công tháng';$('#head').innerHTML='<tr><th class="sticky1">Mã NV</th><th class="sticky2">Nhân viên</th>'+Array.from({length:d.daysInMonth},(_,i)=>`<th>${String(i+1).padStart(2,'0')}</th>`).join('')+'<th>Công</th><th>Phép</th><th>KP</th><th>Giờ</th><th>TC</th></tr>';$('#body').innerHTML=d.data.map(t=>`<tr><td class="sticky1">${t.employee_code}</td><td class="sticky2"><strong>${t.full_name}</strong><br><small>${t.job_grade==='technician'?'Bậc thợ':'Phụ điện lạnh'}</small></td>${Array.from({length:d.daysInMonth},(_,i)=>{const day=i+1,a=t.days[day];return`<td><button class="day ${a?.status||''}" data-id="${t.id}" data-day="${day}" ${d.isClosed?'disabled':''}>${codes[a?.status]||'·'}</button></td>`}).join('')}<td>${t.summary.present}</td><td>${t.summary.leave}</td><td>${t.summary.unauthorized}</td><td>${t.summary.work_hours}</td><td>${t.summary.overtime_hours}</td></tr>`).join('');$('#checks').innerHTML=d.data.map(t=>`<label style="display:block;padding:5px"><input type="checkbox" value="${t.id}"> ${t.employee_code} — ${t.full_name}</label>`).join('')}catch(e){toast(e.message,true)}}$('#body').onclick=e=>{const b=e.target.closest('.day');if(!b)return;const t=state.data.find(x=>x.id==b.dataset.id),a=t.days[b.dataset.day]||{},date=`${$('#year').value}-${String($('#month').value).padStart(2,'0')}-${String(b.dataset.day).padStart(2,'0')}`,f=$('#editForm');f.technician_id.value=t.id;f.attendance_date.value=date;f.status.value=a.status||'present';f.check_in.value=a.check_in?.slice(0,5)||'';f.check_out.value=a.check_out?.slice(0,5)||'';f.overtime_hours.value=a.overtime_hours||0;f.note.value=a.note||'';$('#employee').textContent=`${t.employee_code} — ${t.full_name}`;$('#editTitle').textContent=`Chấm công ngày ${String(b.dataset.day).padStart(2,'0')}/${String($('#month').value).padStart(2,'0')}/${$('#year').value}`;open('#editModal')};$('#editForm').onsubmit=async e=>{e.preventDefault();try{await api('/admin/api/attendance',{method:'POST',body:JSON.stringify(Object.fromEntries(new FormData(e.currentTarget)))});close();toast('Đã lưu chấm công');load()}catch(x){toast(x.message,true)}};$('#bulk').onclick=()=>{if(state.closed)return toast('Tháng đã chốt',true);$('#bulkForm').attendance_date.value=`${$('#year').value}-${String($('#month').value).padStart(2,'0')}-${String(now.getDate()).padStart(2,'0')}`;open('#bulkModal')};$('#bulkForm').onsubmit=async e=>{e.preventDefault();const d=Object.fromEntries(new FormData(e.currentTarget));d.technician_ids=[...$('#checks').querySelectorAll(':checked')].map(x=>Number(x.value));try{await api('/admin/api/attendance/bulk',{method:'POST',body:JSON.stringify(d)});close();toast('Đã chấm công hàng loạt');load()}catch(x){toast(x.message,true)}};$('#closeMonth').onclick=async()=>{const path=state.closed?'reopen-month':'close-month';if(!confirm(`${state.closed?'Mở khóa':'Chốt'} công tháng này?`))return;try{await api('/admin/api/attendance/'+path,{method:'POST',body:JSON.stringify({month:$('#month').value,year:$('#year').value})});load()}catch(x){toast(x.message,true)}};$('#excel').onclick=()=>location.href=`/admin/api/attendance/export?month=${$('#month').value}&year=${$('#year').value}`;[$('#month'),$('#year'),$('#grade')].forEach(x=>x.onchange=load);let timer;$('#search').oninput=()=>{clearTimeout(timer);timer=setTimeout(load,300)};$('#reset').onclick=()=>{$('#search').value='';$('#grade').value='';load()};load()})();
</script><script>
(()=>{
 const csrf=<%- JSON.stringify(csrfToken) %>,form=document.getElementById('editForm'),body=document.getElementById('body');
 const pad=v=>String(v).padStart(2,'0'),timePattern=/^([01]\d|2[0-3]):[0-5]\d$/,datePattern=/^\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\d|3[01])$/;
 const normalizeTime=value=>{const text=String(value||'');const plain=text.match(/^([01]\d|2[0-3]):[0-5]\d/);if(plain)return plain[0];const iso=text.match(/T([01]\d|2[0-3]):[0-5]\d/);return iso?iso[0].slice(1):''};
 const minutes=value=>{if(!timePattern.test(value))return null;const[h,m]=value.split(':').map(Number);return h*60+m};
 const notify=(message,error=false)=>{const item=document.createElement('div');item.className='toast'+(error?' err':'');item.textContent=message;document.body.append(item);setTimeout(()=>item.remove(),3500)};
 const close=()=>{document.getElementById('editModal').hidden=true};
 form.noValidate=true;
 const work=document.createElement('div');work.className='full';work.innerHTML='<label>Số giờ làm</label><strong id="calculatedHours">0 giờ</strong>';form.querySelector('textarea[name="note"]').closest('.full').before(work);
 function updateHours(){const a=minutes(form.check_in.value),b=minutes(form.check_out.value);document.getElementById('calculatedHours').textContent=a!=null&&b!=null&&b>a?`${Math.round((b-a)/60*100)/100} giờ`:'0 giờ'}
 function toggleTimes(){const required=form.status.value==='present';form.check_in.required=required;form.check_out.required=required;if(!required){form.check_in.value='';form.check_out.value=''}updateHours()}
 form.status.addEventListener('change',toggleTimes);form.check_in.addEventListener('input',updateHours);form.check_out.addEventListener('input',updateHours);
 body.onclick=async event=>{const button=event.target.closest('.day');if(!button)return;try{const params=new URLSearchParams({month:document.getElementById('month').value,year:document.getElementById('year').value,search:document.getElementById('search').value,job_grade:document.getElementById('grade').value}),response=await fetch('/admin/api/attendance?'+params,{credentials:'same-origin',headers:{Accept:'application/json'}}),data=await response.json();if(!response.ok)throw Error(data.message||'Không thể tải chấm công.');const employee=data.data.find(x=>x.id==button.dataset.id),item=employee.days[button.dataset.day]||{},date=`${document.getElementById('year').value}-${pad(document.getElementById('month').value)}-${pad(button.dataset.day)}`;form.technician_id.value=employee.id;form.attendance_date.value=date;form.status.value=item.status||'present';form.check_in.value=normalizeTime(item.check_in);form.check_out.value=normalizeTime(item.check_out);form.overtime_hours.value=item.overtime_hours??0;form.note.value=item.note||'';document.getElementById('employee').textContent=`${employee.employee_code} — ${employee.full_name}`;document.getElementById('editTitle').textContent=`Chấm công ngày ${pad(button.dataset.day)}/${pad(document.getElementById('month').value)}/${document.getElementById('year').value}`;toggleTimes();document.getElementById('editModal').hidden=false}catch(error){notify(error.message,true)}};
 form.onsubmit=async event=>{event.preventDefault();const data=Object.fromEntries(new FormData(form)),overtimeText=String(data.overtime_hours??'').trim(),overtime=Number(overtimeText);if(!datePattern.test(data.attendance_date))return notify('Ngày chấm công không hợp lệ.',true);if(overtimeText===''||!Number.isFinite(overtime)||overtime<0)return notify('Tăng ca phải là số lớn hơn hoặc bằng 0.',true);if(data.status==='present'){if(!data.check_in)return notify('Vui lòng nhập giờ vào.',true);if(!timePattern.test(data.check_in))return notify('Giờ vào không hợp lệ, định dạng phải là HH:mm.',true);if(!data.check_out)return notify('Vui lòng nhập giờ ra.',true);if(!timePattern.test(data.check_out))return notify('Giờ ra không hợp lệ, định dạng phải là HH:mm.',true);if(minutes(data.check_out)<=minutes(data.check_in))return notify('Giờ ra phải lớn hơn giờ vào.',true)}else{data.check_in='';data.check_out=''}data.overtime_hours=overtime;try{const response=await fetch('/admin/api/attendance',{method:'POST',credentials:'same-origin',headers:{Accept:'application/json','Content-Type':'application/json','X-CSRF-Token':csrf},body:JSON.stringify(data)}),result=await response.json();if(!response.ok)throw Error(result.message||'Không thể lưu chấm công.');close();notify('Đã lưu chấm công');document.getElementById('month').dispatchEvent(new Event('change'))}catch(error){notify(error.message,true)}};
 const bulkForm=document.getElementById('bulkForm'),bulkStatus=bulkForm.status,checks=bulkForm.querySelector('#checks').closest('.full');bulkForm.noValidate=true;
 const bulkTimes=document.createElement('div');bulkTimes.className='full';bulkTimes.innerHTML='<div class="form"><div><label>Giờ vào</label><input name="check_in" type="time" value="07:45"></div><div><label>Giờ ra</label><input name="check_out" type="time" value="17:30"></div><div><label>Tăng ca đã duyệt (giờ)</label><input name="overtime_hours" type="number" min="0" step="0.5" value="0"></div></div>';checks.before(bulkTimes);bulkStatus.addEventListener('change',()=>{bulkTimes.hidden=bulkStatus.value!=='present'});
})();
</script>
<% if (can('attendance', 'delete')) { %>
<style>.abtn.danger{background:#b43d3d;color:#fff}.abtn.danger:hover{background:#963030}.abtn:disabled{cursor:not-allowed;opacity:.55}</style>
<script>
(()=>{
 const csrf=<%- JSON.stringify(csrfToken) %>,actions=document.querySelector('.acts'),closeButton=document.getElementById('closeMonth');
 if(!actions||!closeButton)return;
 const button=document.createElement('button');button.className='abtn danger';button.id='deleteAttendanceMonth';button.type='button';button.innerHTML='<i class="fa-solid fa-trash-can"></i> Xóa chấm công';actions.insertBefore(button,closeButton);
 const notify=(message,error=false)=>{const item=document.createElement('div');item.className='toast'+(error?' err':'');item.textContent=message;document.body.append(item);setTimeout(()=>item.remove(),3500)};
 button.onclick=async()=>{const month=document.getElementById('month').value,year=document.getElementById('year').value;if(!confirm(`Xóa toàn bộ ngày đã chấm công trong tháng ${month}/${year}? Thao tác này không thể hoàn tác.`))return;button.disabled=true;try{const response=await fetch('/admin/api/attendance/month',{method:'DELETE',credentials:'same-origin',headers:{Accept:'application/json','Content-Type':'application/json','X-CSRF-Token':csrf},body:JSON.stringify({month,year})}),contentType=response.headers.get('content-type')||'',result=contentType.includes('application/json')?await response.json():null;if(!response.ok)throw Error(result?.message||(response.status===404?'API xóa chấm công chưa được tải. Vui lòng khởi động lại máy chủ.':'Không thể xóa chấm công.'));notify(`Đã xóa ${result.deleted} ngày chấm công trong tháng ${month}/${year}.`);document.getElementById('month').dispatchEvent(new Event('change'))}catch(error){notify(error.message,true)}finally{button.disabled=false}};
})();
</script>
<% } %>
</body></html>
