<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %></title>
    <link rel="stylesheet" href="/admin/css/1.css?v=20260811-2">
    <style>
        .account-page { max-width: 760px; margin: 90px auto 40px; padding: 0 20px; }
        .account-card { background: #fff; padding: 28px; border-radius: 8px; box-shadow: 0 1px 4px rgba(0,0,0,.12); }
        .account-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }
        .account-grid .full { grid-column: 1 / -1; }
        .account-card label { display: block; margin-bottom: 6px; font-weight: 600; }
        .account-card input { width: 100%; padding: 10px; border: 1px solid #ccd3db; border-radius: 4px; }
        .account-avatar { width: 88px; height: 88px; object-fit: cover; border-radius: 50%; margin-bottom: 12px; }
        .notice { padding: 12px; border-radius: 4px; margin: 0 0 18px; }
        .notice.success { background: #dff5e6; color: #176b35; }.notice.error { background: #fde3e3; color: #9b2020; }
        .account-actions { display: flex; gap: 12px; margin-top: 24px; }
    </style>
</head>
<body>
    <main class="account-page">
        <div class="account-card">
            <p><a href="/admin">← Về bảng điều khiển</a></p>
            <h1>Thông tin tài khoản</h1>
            <% if (success_msg && success_msg.length) { %><div class="notice success"><%= success_msg[0] %></div><% } %>
            <% if (error_msg && error_msg.length) { %><div class="notice error"><%= error_msg[0] %></div><% } %>
            <form method="post" action="/admin/account" enctype="multipart/form-data">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="account-grid">
                    <div class="full">
                        <img class="account-avatar" src="<%= account.avatar || `https://ui-avatars.com/api/?name=${encodeURIComponent(account.name)}&background=2c3e50&color=fff&size=120` %>" alt="Ảnh đại diện">
                        <label for="avatar">Ảnh đại diện (tối đa 2 MB)</label>
                        <input id="avatar" name="avatar" type="file" accept="image/*">
                    </div>
                    <div><label for="name">Họ tên</label><input id="name" name="name" required value="<%= account.name %>"></div>
                    <div><label for="phone">Số điện thoại</label><input id="phone" name="phone" required value="<%= account.phone %>"></div>
                    <div class="full"><label for="email">Email</label><input id="email" name="email" type="email" required value="<%= account.email || '' %>"></div>
                    <div class="full"><h2>Đổi mật khẩu</h2><p>Để trống nếu khàng muốn đổi mật khẩu.</p></div>
                    <div><label for="currentPassword">Mật khẩu hiện tại</label><input id="currentPassword" name="currentPassword" type="password" autocomplete="current-password"></div>
                    <div><label for="newPassword">Mật khẩu mới</label><input id="newPassword" name="newPassword" type="password" autocomplete="new-password"></div>
                    <div class="full"><label for="confirmPassword">Xác nhận mật khẩu mới</label><input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password"></div>
                </div>
                <div class="account-actions"><button class="btn btn-primary" type="submit">Lưu thay đổi</button><a class="btn" href="/admin">Hủy</a></div>
            </form>
        </div>
    </main>
</body>
</html>

