<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %></title>
    <link rel="stylesheet" href="/admin/css/admin-login.css?v=20260811-2">
</head>
<body class="admin-login-page">
    <main class="admin-login" aria-labelledby="admin-login-title">
        <section class="admin-login__card">
            <header class="admin-login__brand">
                <img class="admin-login__logo" src="/images/logo.png" alt="Logo Điện máy Nguyễn Hùng">
                <div>
                    <p class="admin-login__company">ĐIỆN MÁY NGUYỄN HÙNG</p>
                    <p class="admin-login__system">HỆ THỐNG QUẢN TRỊ</p>
                </div>
            </header>

            <div class="admin-login__heading">
                <h1 id="admin-login-title">Đăng nhập quản trị</h1>
                <p>Vui lòng đăng nhập để tiếp tục</p>
            </div>

            <% if (error_msg && error_msg.length) { %>
                <div class="admin-login__alert" role="alert">
                    <span aria-hidden="true">!</span>
                    <%= error_msg[0] %>
                </div>
            <% } %>

            <form method="post" action="/admin/login" class="admin-login__form" id="adminLoginForm">
                <div class="admin-login__field">
                    <label for="admin-email">Tên đăng nhập hoặc Email</label>
                    <div class="admin-login__input-wrap">
                        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3.5 5.5h17v13h-17zM4.5 6.5l7.5 5.8 7.5-5.8"/></svg>
                        <input id="admin-email" type="text" name="username" required autocomplete="username" placeholder="admin hoặc admin@nguyenhung.vn">
                    </div>
                </div>
                <div class="admin-login__field">
                    <label for="admin-password">Mật khẩu</label>
                    <div class="admin-login__input-wrap">
                        <svg aria-hidden="true" viewBox="0 0 24 24"><rect x="4.5" y="10" width="15" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
                        <input id="admin-password" type="password" name="password" required autocomplete="current-password" placeholder="Nhập mật khẩu">
                        <button class="admin-login__toggle" type="button" aria-label="Hiện mật khẩu" aria-pressed="false">
                            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M2.5 12s3.5-5 9.5-5 9.5 5 9.5 5-3.5 5-9.5 5-9.5-5-9.5-5Z"/><circle cx="12" cy="12" r="2.5"/></svg>
                        </button>
                    </div>
                </div>
                <button class="admin-login__submit" type="submit">
                    <span class="admin-login__submit-text">ĐĂNG NHẬP</span>
                    <span class="admin-login__spinner" aria-hidden="true"></span>
                </button>
            </form>

            <footer class="admin-login__security">
                <svg aria-hidden="true" viewBox="0 0 24 24"><rect x="4.5" y="10" width="15" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
                <span>Khu vực dành riêng cho quản trị viên</span>
            </footer>
        </section>
    </main>
    <script>
        (() => {
            const form = document.getElementById('adminLoginForm');
            const password = document.getElementById('admin-password');
            const toggle = document.querySelector('.admin-login__toggle');
            toggle.addEventListener('click', () => {
                const visible = password.type === 'text';
                password.type = visible ? 'password' : 'text';
                toggle.setAttribute('aria-pressed', String(!visible));
                toggle.setAttribute('aria-label', visible ? 'Hiện mật khẩu' : 'Ẩn mật khẩu');
            });
            form.addEventListener('submit', () => {
                const submit = form.querySelector('.admin-login__submit');
                submit.disabled = true;
                submit.classList.add('is-loading');
                form.setAttribute('aria-busy', 'true');
            });
        })();
    </script>
</body>
</html>

