                </div>
                <div class="form-group">
                    <label>Mật khẩu <span class="required">*</span></label>
                    <input type="password" class="form-control" id="regPassword" placeholder="Ít nhất 6 ký tự" required minlength="6">
                </div>
                <div class="form-group">
                    <label>Xác nhận mật khẩu <span class="required">*</span></label>
                    <input type="password" class="form-control" id="regConfirm" placeholder="Nhập lại mật khẩu" required>
                </div>
                <button type="submit" class="btn btn--red">ĐĂNG KÝ</button>
            </form>

            <div class="auth-modal__switch">
                Đã có tài khoản? <a data-switch="login">Đăng nhập</a>
            </div>

