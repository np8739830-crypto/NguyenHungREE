    }

    .header__user:hover .header__user-avatar,
    .header__user:focus-visible .header__user-avatar {
        transform: scale(1.02);
        border-color: rgba(255, 255, 255, .55);
        box-shadow: 0 5px 16px rgba(0, 0, 0, .24);
