    }
    
    .auth-modal__forgot a:hover {
        color: var(--blue-bright);
    }
    
    .auth-modal__error {
        display: none;
        background: #FEE2E2;
        color: #B91C1C;
        padding: 10px 14px;
        border-radius: var(--radius-sm);
