    /* ==========================================
   BACK TO TOP
   ========================================== */
    
    .back-to-top {
        position: fixed;
        bottom: 25px;
        right: 25px;
        width: 44px;
        height: 44px;
        background: linear-gradient(135deg, var(--blue-bright), var(--cyan-cool));
        color: var(--white);
        border-radius: 50%;
